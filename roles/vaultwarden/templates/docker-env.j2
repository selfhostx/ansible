# {{ ansible_managed }}
# more options: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

DOMAIN=https://{{ vaultwarden_hostname }}

{% if vaultwarden_admin_token_argon2_prehashed is defined %}
ADMIN_TOKEN='{{ vaultwarden_admin_token_argon2_prehashed | replace('$$', '$') }}'
{% elif vaultwarden_admin_token is defined %}
ADMIN_TOKEN='{{ vaultwarden_admin_token_argon2.stdout }}'
{% endif %}
{% if vaultwarden_database_url | length > 0 %}
DATABASE_URL='{{ vaultwarden_database_url }}'
{% endif %}

# EXTRA Vars:
{{ vaultwarden_env_extra }}
