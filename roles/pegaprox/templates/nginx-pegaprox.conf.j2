# see: https://docs.pegaprox.com/configuration/reverse-proxy/

upstream pegaprox_app {
    server 127.0.0.1:5000;
}
upstream pegaprox_vnc {
    server 127.0.0.1:5001;
}
upstream pegaprox_ssh {
    server 127.0.0.1:5002;
}

server {
  listen 80 {% if pegaprox_nginx_remove_default_config %}default_server{% endif %};
  listen [::]:80 {% if pegaprox_nginx_remove_default_config %}default_server{% endif %};
  server_name {{ pegaprox_hostname }};

{% if pegaprox_hide_nginx_version %}
  server_tokens off;
{% endif %}
  location / {
    # remember: 301 = moved permanently (search engines will react), 302 = moved temporarily (search engines will hold back)
    return 301 https://$server_name$request_uri;
  }
}

server {
  listen 443 ssl {% if pegaprox_nginx_remove_default_config %}default_server{% endif %};
  listen [::]:443 ssl {% if pegaprox_nginx_remove_default_config %}default_server{% endif %};
  http2 on;
  server_name {{ pegaprox_hostname }};

{% if pegaprox_nginx_use_nginx_common_snippet %}
  include {{ pegaprox_nginx_tls_hardening_snippet }};
{% else %}
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers CHACHA20:-AES:AESGCM:AESCCM:!kRSA:!PSK:!aECDSA:!aDSS:!aNULL:!eNULL:!SHA1:!MD5;
  ssl_ecdh_curve X25519:secp521r1:secp384r1;
{% if pegaprox_tls_hsts_enable %}
  add_header Strict-Transport-Security "max-age={{ pegaprox_tls_hsts_time }}";
{% endif %}
{% endif %}

  ssl_certificate {{ pegaprox_nginx_ssl_certificate }};
  ssl_certificate_key {{ pegaprox_nginx_ssl_certificate_key }};

{% if pegaprox_hide_nginx_version %}
  server_tokens off;
{% endif %}

  client_max_body_size 100g;   # match PegaProx upload limit for ISOs
  proxy_connect_timeout 10;
  proxy_read_timeout    3600;
  proxy_send_timeout    3600;

  # Main app + WebSocket
  location / {
      proxy_pass https://pegaprox_app;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_http_version 1.1;
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
  }

  # SSE - buffering must be off
  location /api/sse/ {
      proxy_pass https://pegaprox_app;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 86400;
  }

  # VNC console websocket (port 5001)
  location ~ ^/api/clusters/.*/vncwebsocket {
      proxy_pass https://pegaprox_vnc;
      proxy_http_version 1.1;
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host       $host;
      proxy_set_header X-Real-IP  $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 3600;
  }

  # SSH console websocket (port 5002)
  location ~ ^/api/clusters/.*/shellws {
      proxy_pass http://pegaprox_ssh;
      proxy_http_version 1.1;
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host       $host;
      proxy_set_header X-Real-IP  $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 3600;
  }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
